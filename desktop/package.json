{
  "name": "eyespysc-desktop",
  "private": true,
  "version": "0.1.0-rc.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc -b --pretty false",
    "tauri": "tauri",
    "tauri:release": "VITE_BUILD_REVISION=\"${VITE_BUILD_REVISION:-$(git rev-parse HEAD)}\" tauri build --config src-tauri/tauri.release.conf.json --target x86_64-unknown-linux-gnu"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.27.0",
    "@tauri-apps/cli": "2.11.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.27.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.16",
    "globals": "15.14.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.20.0",
    "vite": "6.4.5"
  }
}
